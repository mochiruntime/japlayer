<Page
    x:Class="Japlayer.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Japlayer.ViewModels"
    xmlns:models="using:Japlayer.Models"
    xmlns:controls="using:Japlayer.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- Active Filter Chip Template -->
        <DataTemplate x:Key="ActiveFilterChipTemplate" x:DataType="vm:ActiveFilterChip">
            <Grid CornerRadius="13"
                  Height="26"
                  Padding="10,0,6,0"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1">
                <Border CornerRadius="13"
                        Margin="-10,0,-6,0"
                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                        Visibility="{x:Bind IsInclude}"/>
                <Border CornerRadius="13"
                        Margin="-10,0,-6,0"
                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        Visibility="{x:Bind IsExclude}"/>
                <Border CornerRadius="13"
                        Margin="-10,0,-6,0"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        Visibility="{x:Bind IsRange}"/>

                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Label}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button AutomationProperties.AutomationId="RemoveFilterChipButton"
                            Command="{x:Bind RemoveCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="2"
                            Width="18"
                            Height="18"
                            ToolTipService.ToolTip="Remove filter">
                        <FontIcon Glyph="&#xE711;" FontSize="9"/>
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Pinned Header + Filter & Sort Toolbar (OverlayInputPassThroughElement target) -->
        <Grid x:Name="TopControlsContainer" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header (Title + Item Count + Search + Shuffle) -->
            <Grid Grid.Row="0" Padding="24,20,24,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Library" Style="{StaticResource TitleTextBlockStyle}" Margin="0"/>
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,2"
                            VerticalAlignment="Center">
                        <TextBlock AutomationProperties.AutomationId="ItemCountTextBlock"
                                   Text="{x:Bind ViewModel.ItemCountText, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <AutoSuggestBox AutomationProperties.AutomationId="SearchAutoSuggestBox"
                                    Width="320"
                                    PlaceholderText="Search by ID, title, cast, tags..."
                                    QueryIcon="Find"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button AutomationProperties.AutomationId="ShuffleButton"
                            Command="{x:Bind ViewModel.ShuffleCommand}"
                            Width="32"
                            Height="32"
                            Padding="0"
                            ToolTipService.ToolTip="Shuffle / Random">
                        <FontIcon Glyph="&#xE8B1;" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Filter & Sort Toolbar (all 7 filter controls in one flat WrapPanel; Sort always top-right) -->
            <Grid Grid.Row="1"
                  Padding="24,4,24,10"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Unified Wrapping Filters -->
                <controls:WrapPanel Grid.Column="0" HorizontalSpacing="8" VerticalSpacing="8">
                    <controls:FacetFilterButton Facet="{x:Bind ViewModel.TagsFacet}"
                                                OverlayPassThroughElement="{x:Bind TopControlsContainer}"/>
                    <controls:FacetFilterButton Facet="{x:Bind ViewModel.GenresFacet}"
                                                OverlayPassThroughElement="{x:Bind TopControlsContainer}"/>
                    <controls:FacetFilterButton Facet="{x:Bind ViewModel.CastFacet}"
                                                OverlayPassThroughElement="{x:Bind TopControlsContainer}"/>
                    <controls:FacetFilterButton Facet="{x:Bind ViewModel.StudiosFacet}"
                                                OverlayPassThroughElement="{x:Bind TopControlsContainer}"/>
                    <controls:FacetFilterButton Facet="{x:Bind ViewModel.SeriesFacet}"
                                                OverlayPassThroughElement="{x:Bind TopControlsContainer}"/>

                    <!-- Rating RangeSelector Flyout -->
                    <DropDownButton x:Name="RatingFilterButton"
                                    AutomationProperties.AutomationId="RatingFilterButton">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE734;" FontSize="12"/>
                            <TextBlock Text="{x:Bind ViewModel.RatingButtonLabel, Mode=OneWay}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Width="240" Spacing="8">
                                    <Grid>
                                        <TextBlock AutomationProperties.AutomationId="RatingRangeText"
                                                   Text="{x:Bind ViewModel.RatingRangeDisplay, Mode=OneWay}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   VerticalAlignment="Center"/>
                                        <HyperlinkButton AutomationProperties.AutomationId="ResetRatingButton"
                                                         Content="Reset"
                                                         Command="{x:Bind ViewModel.ResetRatingFilterCommand}"
                                                         Visibility="{x:Bind ViewModel.IsRatingFilterActive, Mode=OneWay}"
                                                         HorizontalAlignment="Right"
                                                         Padding="4,0"/>
                                    </Grid>
                                    <toolkit:RangeSelector AutomationProperties.AutomationId="RatingRangeSelector"
                                                           Minimum="0"
                                                           Maximum="5"
                                                           StepFrequency="1"
                                                           RangeStart="{x:Bind ViewModel.RatingMin, Mode=TwoWay}"
                                                           RangeEnd="{x:Bind ViewModel.RatingMax, Mode=TwoWay}"/>
                                    <Grid>
                                        <TextBlock Text="0" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="5" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Runtime RangeSelector Flyout -->
                    <DropDownButton x:Name="RuntimeFilterButton"
                                    AutomationProperties.AutomationId="RuntimeFilterButton">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE916;" FontSize="12"/>
                            <TextBlock Text="{x:Bind ViewModel.RuntimeButtonLabel, Mode=OneWay}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Width="250" Spacing="8">
                                    <Grid>
                                        <TextBlock AutomationProperties.AutomationId="RuntimeRangeText"
                                                   Text="{x:Bind ViewModel.RuntimeRangeDisplay, Mode=OneWay}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   VerticalAlignment="Center"/>
                                        <HyperlinkButton AutomationProperties.AutomationId="ResetRuntimeButton"
                                                         Content="Reset"
                                                         Command="{x:Bind ViewModel.ResetRuntimeFilterCommand}"
                                                         Visibility="{x:Bind ViewModel.IsRuntimeFilterActive, Mode=OneWay}"
                                                         HorizontalAlignment="Right"
                                                         Padding="4,0"/>
                                    </Grid>
                                    <toolkit:RangeSelector AutomationProperties.AutomationId="RuntimeRangeSelector"
                                                           Minimum="0"
                                                           Maximum="{x:Bind ViewModel.RuntimeMaxBound, Mode=OneWay}"
                                                           StepFrequency="15"
                                                           RangeStart="{x:Bind ViewModel.RuntimeMin, Mode=TwoWay}"
                                                           RangeEnd="{x:Bind ViewModel.RuntimeMax, Mode=TwoWay}"/>
                                    <Grid>
                                        <TextBlock Text="0m" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{x:Bind ViewModel.RuntimeMaxBound, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </controls:WrapPanel>

                <!-- Right: Pinned Sort Field + Direction Toggle -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Top"
                            Margin="16,0,0,0">
                    <TextBlock Text="Sort:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>

                    <DropDownButton x:Name="SortDropDownButton"
                                    AutomationProperties.AutomationId="SortDropDownButton"
                                    Content="{x:Bind ViewModel.SelectedSortField.DisplayName, Mode=OneWay}">
                        <DropDownButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <ListView ItemsSource="{x:Bind ViewModel.SortFieldOptions}"
                                          SelectedItem="{x:Bind ViewModel.SelectedSortField, Mode=TwoWay}"
                                          SelectionMode="Single"
                                          MinWidth="160">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:LibrarySortFieldOption">
                                            <TextBlock Text="{x:Bind DisplayName}" Padding="4,2"/>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Button AutomationProperties.AutomationId="SortDirectionButton"
                            Command="{x:Bind ViewModel.ToggleSortDirectionCommand}"
                            Visibility="{x:Bind ViewModel.IsNotRandomSort, Mode=OneWay}"
                            Width="32"
                            Height="32"
                            Padding="0"
                            ToolTipService.ToolTip="Toggle sort direction">
                        <FontIcon Glyph="{x:Bind ViewModel.SortDirectionGlyph, Mode=OneWay}" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Row 1: Active Filter Chips Bar -->
        <Grid Grid.Row="1"
              Visibility="{x:Bind ViewModel.HasActiveFilters, Mode=OneWay}"
              Padding="24,8,24,10"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ItemsControl Grid.Column="0"
                          ItemsSource="{x:Bind ViewModel.ActiveFilterChips}"
                          ItemTemplate="{StaticResource ActiveFilterChipTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <HyperlinkButton Grid.Column="1"
                             AutomationProperties.AutomationId="ClearAllFiltersButton"
                             Content="Clear all"
                             Command="{x:Bind ViewModel.ClearAllFiltersCommand}"
                             Padding="6,2"
                             Margin="8,0,0,0"
                             VerticalAlignment="Top"/>
        </Grid>

        <!-- Row 2: Scrollable Media GridView + Empty State -->
        <Grid Grid.Row="2">
            <GridView x:Name="MediaGrid"
                      AutomationProperties.AutomationId="MediaGrid"
                      ItemsSource="{x:Bind ViewModel.MediaItems, Mode=OneWay}"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="MediaGrid_ItemClick"
                      Padding="18,12,24,24">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:LibraryItemViewModel">
                        <Grid AutomationProperties.AutomationId="{x:Bind Id}"
                              Width="300"
                              Height="250"
                              Margin="6"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1"
                              CornerRadius="8"
                              PointerEntered="MediaItem_PointerEntered"
                              PointerMoved="MediaItem_PointerMoved"
                              PointerExited="MediaItem_PointerExited"
                              RightTapped="MediaItem_RightTapped">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Cover Image + Top-Right Rating Pill -->
                            <Grid Grid.Row="0">
                                <controls:MediaCoverView Source="{x:Bind DisplayImageSource, Mode=OneWay}"
                                                         Stretch="UniformToFill"
                                                         CornerRadius="8,8,0,0"/>

                                <Border Visibility="{x:Bind HasRating, Mode=OneWay}"
                                        Background="#B0000000"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        Margin="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <FontIcon Glyph="&#xE735;" FontSize="10" Foreground="#FFD166"/>
                                        <TextBlock Text="{x:Bind RatingDisplay, Mode=OneWay}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFD166"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Auto-Sizing Footer (Title + Date & Counts Pills) -->
                            <Grid Grid.Row="1"
                                  Padding="10,8"
                                  RowSpacing="4"
                                  Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{x:Bind Title}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap"
                                           ToolTipService.ToolTip="{x:Bind Title}"/>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind FormattedReleaseDate, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Border Visibility="{x:Bind HasHighlights, Mode=OneWay}"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="4"
                                                Padding="6,1"
                                                ToolTipService.ToolTip="Highlights">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE945;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="{x:Bind HighlightCount, Mode=OneWay}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Visibility="{x:Bind HasScenes, Mode=OneWay}"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="4"
                                                Padding="6,1"
                                                ToolTipService.ToolTip="Scenes">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE714;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="{x:Bind SceneCount, Mode=OneWay}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- Empty State -->
            <StackPanel AutomationProperties.AutomationId="EmptyStatePanel"
                        Visibility="{x:Bind ViewModel.IsEmptyResult, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <FontIcon Glyph="&#xE721;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="No matching media items"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Try adjusting your search query or clearing active filters."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
                <Button AutomationProperties.AutomationId="ResetAllFiltersButton"
                        Content="Reset all filters"
                        Command="{x:Bind ViewModel.ClearAllFiltersCommand}"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
