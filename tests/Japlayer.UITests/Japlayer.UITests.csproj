    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Japlayer.Data\Japlayer.Data.csproj" />
  </ItemGroup>
